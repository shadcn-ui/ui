{
  "name": "saaze-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "description": "کتابخانه رابط کاربری راست‌به‌چپ و فارسی برای Vue 3",
  "homepage": "https://github.com/ReyhaneENS/saaze-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReyhaneENS/saaze-ui.git"
  },
  "scripts": {
    "dev": "pnpm --filter @saaze/docs dev",
    "dev:docs": "pnpm --filter @saaze/docs dev",
    "build": "pnpm build:utils && pnpm build:ui && pnpm build:docs",
    "build:utils": "pnpm --filter @saaze/utils build",
    "build:ui": "pnpm --filter @saaze/ui build",
    "build:docs": "pnpm --filter @saaze/docs build",
    "preview:docs": "pnpm --filter @saaze/docs preview",
    "test": "pnpm --filter @saaze/utils test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  }
}
